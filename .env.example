# ============================================
# Randyproductions Beat Store — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NEVER be committed.
#
# IMPORTANT: Set these SAME values in Vercel → Settings → Environment Variables
# ============================================

# ─── SUPABASE ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── PAYPAL ───
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to https://api-m.paypal.com for live, or leave default for sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── RESEND (Email Delivery) ───
RESEND_API_KEY=
# Must be a verified domain in Resend dashboard (not onboarding@resend.dev in production)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── SITE URL ───
# Your Vercel deployment URL (e.g. https://randyproductions.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── ADMIN ───
# Admin login credentials (server-side only — NOT exposed to client)
ADMIN_EMAIL=
ADMIN_PASSWORD=
