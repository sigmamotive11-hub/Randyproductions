{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/webhook.js"
    }
  ],
  "functions": {
    "api/webhook.js": {
      "runtime": "nodejs18.x"
    }
  }
}
